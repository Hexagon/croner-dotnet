<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Croner</RootNamespace>
    <AssemblyName>Croner</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet -->
  <PropertyGroup>
    <PackageId>Croner</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Hexagon</Authors>
    <Copyright>Copyright (c) Hexagon</Copyright>
    <Description>Cron for .NET: parse cron expressions (seconds, years, L, W, #, +), find next and previous occurrences in any TimeZoneInfo with correct daylight saving time handling, describe schedules in plain language, and run scheduled jobs. No dependencies.</Description>
    <PackageTags>cron;crontab;cron-expression;scheduler;schedule;job;timer;timezone;dst;ocps;quartz</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hexagon/croner-dotnet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/hexagon/croner-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/hexagon/croner-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Croner.Tests" />
  </ItemGroup>

</Project>
